{
	"name": "obsidian-omnifocus-bridge",
	"version": "1.0.4",
	"description": "OmniFocus <-> Obsidian sync plugin",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.0",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"tslib": "2.4.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.72.1",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"obsidian": "^1.14.4"
	},
	"overrides": {
		"moment": "2.31.0"
	}
}
